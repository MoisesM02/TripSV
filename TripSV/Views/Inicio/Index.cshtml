@model List<Categoria>
@{
    var destacados = ViewBag.Destacados as List<Sitio> ?? new List<Sitio>();
    var portadas = new[]
    {
        new { Imagen = "tazumal.jpg", Titulo = "Tazumal" },
        new { Imagen = "eltincoo.jpg", Titulo = "El Tunco" },
        new { Imagen = "Coatepeque.jpg", Titulo = "Lago de Coatepeque" },
        new { Imagen = "cerroVerde.jpg", Titulo = "Cerro Verde" },
        new { Imagen = "zonte.jpg", Titulo = "Playa El Zonte" }
    };
}

<div id="carruselPrincipal" class="carousel slide carousel-fade" data-bs-ride="carousel">
    <div class="carousel-indicators">
        @for (var i = 0; i < portadas.Length; i++)
        {
            <button type="button" data-bs-target="#carruselPrincipal" data-bs-slide-to="@i"
                    class="@(i == 0 ? "active" : "")" aria-label="Portada @(i + 1)"></button>
        }
    </div>
    <div class="carousel-inner">
        @for (var i = 0; i < portadas.Length; i++)
        {
            <div class="carousel-item @(i == 0 ? "active" : "")">
                <img class="d-block w-100 slider-slide" src="~/img/@portadas[i].Imagen" alt="@portadas[i].Titulo" />
                <div class="mask rgba-black-light"></div>
                <div class="carousel-caption">
                    <h3 class="h3-responsive" style="color:#FFF">@portadas[i].Titulo</h3>
                </div>
            </div>
        }
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#carruselPrincipal" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#carruselPrincipal" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Siguiente</span>
    </button>
</div>

<div class="container py-5">
    <h2 class="text-center mb-4">Categorías turísticas</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center">Todavía no hay categorías publicadas.</div>
    }
    else
    {
        <div class="row">
            @foreach (var categoria in Model)
            {
                <div class="col-md-4 cats-slides mb-4">
                    <div class="card mb-2 h-100">
                        <img class="card-img-top cats-slide" src="@Url.Action("Imagen", "Categorias", new { id = categoria.Id })"
                             alt="@categoria.Nombre" height="200" />
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title text-center primera-mayuscula">@categoria.Nombre</h4>
                            <p class="card-text line-clamp text-justify">@categoria.Descripcion</p>
                            <div class="mt-auto">
                                <span class="badge bg-secondary mb-2">@categoria.Sitios.Count sitio(s)</span>
                                <a class="btn btn-primary w-100 text-white"
                                   asp-controller="Sitios" asp-action="MostrarSitios" asp-route-id="@categoria.Id">Ver más</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (destacados.Count > 0)
{
    <div class="container py-4">
        <h2 class="text-center mb-4">Sitios mejor calificados</h2>
        <div class="row">
            @foreach (var sitio in destacados)
            {
                <div class="col-lg-4 col-md-6 col-sm-12 mb-4">
                    <div class="card h-100">
                        <img class="card-img-top" src="@Url.Action("Imagen", "Sitios", new { id = sitio.Id })"
                             alt="@sitio.Nombre" height="200" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@sitio.Nombre</h5>
                            <h6 class="text-muted">@sitio.Ubicacion</h6>
                            <partial name="_Estrellas" model="sitio.Calificacion" />
                            <div class="line-clamp mt-2">@sitio.Descripcion</div>
                            <div class="mt-auto pt-3">
                                <a class="btn btn-danger text-white" asp-controller="Sitios" asp-action="Detalle" asp-route-id="@sitio.Id">Ver más</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<div class="container py-4">
    <div id="carruselTestimonios" class="carousel slide text-dark" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active text-center p-4">
                <blockquote class="blockquote text-center">
                    <p class="mb-0">&ldquo; Excelente trabajo. &rdquo;</p>
                    <footer class="blockquote-footer">Carlos Miranda</footer>
                </blockquote>
            </div>
            <div class="carousel-item text-center p-4">
                <blockquote class="blockquote text-center">
                    <p class="mb-0">&ldquo; Me encanta la información de los sitios. &rdquo;</p>
                    <footer class="blockquote-footer">María Abrego</footer>
                </blockquote>
            </div>
            <div class="carousel-item text-center p-4">
                <blockquote class="blockquote text-center">
                    <p class="mb-0">&ldquo; Este sitio me ayudó a encontrar los mejores lugares de El Salvador. &rdquo;</p>
                    <footer class="blockquote-footer">Julián Herrera</footer>
                </blockquote>
            </div>
        </div>
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carruselTestimonios" data-bs-slide-to="0" class="active" aria-label="Testimonio 1"></button>
            <button type="button" data-bs-target="#carruselTestimonios" data-bs-slide-to="1" aria-label="Testimonio 2"></button>
            <button type="button" data-bs-target="#carruselTestimonios" data-bs-slide-to="2" aria-label="Testimonio 3"></button>
        </div>
    </div>
</div>
