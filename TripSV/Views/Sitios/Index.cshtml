@model BusquedaSitiosViewModel
@using TripSV.Servicios
@{
    var calificaciones = new[]
    {
        new { Valor = "3", Numero = 3m, Texto = "3 o más estrellas" },
        new { Valor = "4", Numero = 4m, Texto = "4 o más estrellas" },
        new { Valor = "4.5", Numero = 4.5m, Texto = "4.5 o más estrellas" }
    };
    var ordenes = new[]
    {
        new { Valor = SitiosServicio.OrdenCalificacion, Texto = "Mejor calificados" },
        new { Valor = SitiosServicio.OrdenPopulares, Texto = "Más votados" },
        new { Valor = SitiosServicio.OrdenNombre, Texto = "Nombre (A-Z)" },
        new { Valor = SitiosServicio.OrdenRecientes, Texto = "Más recientes" }
    };
}

<div class="container py-4">
    <h1 class="mb-3">Catálogo de sitios turísticos</h1>

    <div class="card mb-4 filtros-busqueda">
        <div class="card-body">
            <form asp-action="Index" method="get" class="row g-2 align-items-end">
                <div class="col-lg-4 col-md-12">
                    <label class="form-label" for="texto">Buscar</label>
                    <input type="search" id="texto" name="texto" value="@Model.Texto" class="form-control"
                           placeholder="Nombre, lugar o tipo de destino" maxlength="100" />
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label" for="categoriaId">Categoría</label>
                    <select id="categoriaId" name="categoriaId" class="form-select">
                        <option value="">Todas</option>
                        @foreach (var categoria in Model.Categorias)
                        {
                            <option value="@categoria.Id" selected="@(Model.CategoriaId == categoria.Id)">@(char.ToUpper(categoria.Nombre[0]) + categoria.Nombre[1..])</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label" for="ubicacion">Departamento</label>
                    <select id="ubicacion" name="ubicacion" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var ubicacion in Model.Ubicaciones)
                        {
                            <option value="@ubicacion" selected="@(string.Equals(Model.Ubicacion, ubicacion, StringComparison.CurrentCultureIgnoreCase))">@ubicacion</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4">
                    <label class="form-label" for="calificacionMinima">Calificación</label>
                    <select id="calificacionMinima" name="calificacionMinima" class="form-select">
                        <option value="">Cualquiera</option>
                        @foreach (var opcion in calificaciones)
                        {
                            <option value="@opcion.Valor" selected="@(Model.CalificacionMinima == opcion.Numero)">@opcion.Texto</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-6">
                    <label class="form-label" for="orden">Ordenar por</label>
                    <select id="orden" name="orden" class="form-select">
                        @foreach (var opcion in ordenes)
                        {
                            <option value="@opcion.Valor" selected="@(Model.Orden == opcion.Valor)">@opcion.Texto</option>
                        }
                    </select>
                </div>
                <div class="col-12 d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-danger">Buscar</button>
                    @if (Model.HayFiltros)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar filtros</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <p class="text-muted">
        @Model.Resultados.Count destino(s)
        @(Model.HayFiltros ? "encontrado(s)" : "en el catálogo")
        @if (!string.IsNullOrWhiteSpace(Model.Texto))
        {
            <text>para <strong>«@Model.Texto»</strong></text>
        }
    </p>

    @if (Model.Resultados.Count == 0)
    {
        <div class="alert alert-warning">
            @if (Model.HayFiltros)
            {
                <p class="mb-2">No encontramos destinos con esos criterios.</p>
                <p class="mb-0">
                    Pruebe con menos palabras, quite algún filtro o
                    <a asp-action="Index">vea el catálogo completo</a>.
                </p>
            }
            else
            {
                <p class="mb-0">Todavía no hay sitios publicados.</p>
            }
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var sitio in Model.Resultados)
            {
                <div class="col-lg-4 col-md-6 col-sm-12 p-3">
                    <div class="card h-100">
                        <img class="card-img-top" src="@Url.Action("Imagen", "Sitios", new { id = sitio.Id })"
                             alt="@sitio.Nombre" height="220" loading="lazy" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@sitio.Nombre</h5>
                            <h6 class="text-muted">@sitio.Ubicacion</h6>
                            <span class="badge bg-primary primera-mayuscula mb-2 align-self-start">@sitio.Categoria?.Nombre</span>
                            <partial name="_Estrellas" model="sitio.Calificacion" />
                            <small class="text-muted">@sitio.TotalPuntuaciones calificación(es)</small>
                            <div class="line-clamp mt-2">@sitio.Descripcion</div>
                            <div class="mt-auto pt-3">
                                <a class="btn btn-danger text-white" asp-action="Detalle" asp-route-id="@sitio.Id">Ver más</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
