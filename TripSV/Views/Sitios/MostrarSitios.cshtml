@model List<Sitio>
@{
    var categoria = ViewBag.Categoria as Categoria;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Categorias" asp-action="Index">Categorías</a></li>
            <li class="breadcrumb-item active primera-mayuscula" aria-current="page">@categoria?.Nombre</li>
        </ol>
    </nav>

    <h1 class="primera-mayuscula">@categoria?.Nombre</h1>
    @if (!string.IsNullOrWhiteSpace(categoria?.Descripcion))
    {
        <p class="lead">@categoria.Descripcion</p>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">No encontramos sitios en esta categoría todavía.</div>
    }
    else
    {
        <div class="row">
            @foreach (var sitio in Model)
            {
                <div class="col-lg-4 col-md-6 col-sm-12 p-3">
                    <div class="card h-100">
                        <img class="card-img-top" src="@Url.Action("Imagen", "Sitios", new { id = sitio.Id })"
                             alt="@sitio.Nombre" height="220" />
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@sitio.Nombre</h5>
                            <h6 class="text-muted">@sitio.Ubicacion</h6>
                            <partial name="_Estrellas" model="sitio.Calificacion" />
                            <div class="line-clamp mt-2">@sitio.Descripcion</div>
                            <div class="mt-auto pt-3">
                                <a class="btn btn-danger text-white" asp-action="Detalle" asp-route-id="@sitio.Id">Ver más</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
