@model List<Sitio>
@{
    var categoria = ViewBag.Categoria as Categoria;
}

<div class="container py-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Categorias" asp-action="Index">Categorías</a></li>
            <li class="breadcrumb-item active primera-mayuscula" aria-current="page">@categoria?.Nombre</li>
        </ol>
    </nav>

    <div class="encabezado-pagina">
        <span class="antetitulo">Categoría</span>
        <h1 class="primera-mayuscula">@categoria?.Nombre</h1>
        <p>
            @if (!string.IsNullOrWhiteSpace(categoria?.Descripcion))
            {
                @categoria.Descripcion
                <br />
            }
            @Model.Count destino(s) en esta categoría
        </p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">
            No encontramos sitios en esta categoría todavía.
            <a asp-action="Index">Vea el catálogo completo</a>.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var sitio in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <partial name="_TarjetaSitio" model="sitio" />
                </div>
            }
        </div>
    }
</div>
