@model IniciarSesionViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="text-center mb-4">Iniciar sesión</h4>

                    <form asp-action="IniciarSesion" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="UrlRetorno" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Usuario" class="form-label"></label>
                            <input asp-for="Usuario" class="form-control" autofocus />
                            <span asp-validation-for="Usuario" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input asp-for="Recordarme" class="form-check-input" />
                            <label asp-for="Recordarme" class="form-check-label"></label>
                        </div>

                        <button type="submit" class="btn btn-danger w-100">Entrar</button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-action="RecuperarPassword">¿Olvidó su contraseña?</a>
                    </div>
                    <div class="text-center mt-2">
                        <a asp-action="Registrar">Crear una cuenta</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
