@model RecuperarPasswordViewModel
@{
    var enlace = ViewBag.Enlace as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="text-center mb-3">Recuperar contraseña</h4>
                    <p class="text-center text-muted">
                        Ingrese el correo asociado a su cuenta de Trips SV, o su nombre de usuario.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(enlace))
                    {
                        <div class="alert alert-success">
                            <p class="mb-1">Enlace de recuperación generado:</p>
                            <a href="@enlace" class="small text-break">@enlace</a>
                        </div>
                    }

                    <form asp-action="RecuperarPassword" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label"></label>
                            <input asp-for="Correo" class="form-control" type="email" />
                            <span asp-validation-for="Correo" class="text-danger"></span>
                        </div>

                        <div class="text-center text-muted mb-3">o</div>

                        <div class="mb-3">
                            <label asp-for="Usuario" class="form-label"></label>
                            <input asp-for="Usuario" class="form-control" />
                            <span asp-validation-for="Usuario" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-danger w-100">Generar enlace de recuperación</button>
                    </form>

                    <div class="text-center mt-3">
                        <a asp-action="IniciarSesion">Volver al inicio de sesión</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
