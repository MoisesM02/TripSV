@model RestablecerPasswordViewModel

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="text-center mb-4">Cambiar contraseña</h4>

                    <form asp-action="RestablecerPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Usuario" />
                        <input type="hidden" asp-for="Token" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autofocus />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password2" class="form-label"></label>
                            <input asp-for="Password2" class="form-control" />
                            <span asp-validation-for="Password2" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-danger w-100">Cambiar contraseña</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
