@model List<Itinerario>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-1">
        <h1>Mis itinerarios</h1>
        <a class="btn btn-danger" asp-action="Crear">Nuevo itinerario</a>
    </div>
    <p class="text-muted mb-4">Organice sus viajes día por día.</p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            Todavía no tiene itinerarios. Cree uno y agregue los destinos que quiere visitar cada día,
            o empiece desde la página de cualquier <a asp-controller="Sitios" asp-action="Index">sitio</a>.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var itinerario in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@itinerario.Nombre</h5>
                            <div class="mb-2"><partial name="_Estado" model="itinerario" /></div>
                            <p class="mb-1">
                                @itinerario.FechaInicio.ToString("dd/MM/yyyy")
                                @if (itinerario.CantidadDias > 1)
                                {
                                    <text>al @itinerario.FechaFin.ToString("dd/MM/yyyy")</text>
                                }
                            </p>
                            <p class="text-muted mb-2">
                                @itinerario.CantidadDias día(s) · @itinerario.Visitas.Count destino(s)
                            </p>
                            @if (!string.IsNullOrWhiteSpace(itinerario.Notas))
                            {
                                <p class="small line-clamp">@itinerario.Notas</p>
                            }
                            <div class="mt-auto">
                                <a class="btn btn-danger w-100" asp-action="Detalle" asp-route-id="@itinerario.Id">Abrir planificador</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
