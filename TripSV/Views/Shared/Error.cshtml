@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="card mx-auto text-center" style="max-width: 36rem;">
        <div class="card-body p-5">
            <div class="display-4 text-primary mb-3"><i class="bi bi-exclamation-triangle"></i></div>
            <span class="antetitulo">Error inesperado</span>
            <h1 class="h3 mb-3">Ocurrió un problema al procesar su solicitud</h1>
            <p class="text-muted mb-4">El error quedó registrado. Intente de nuevo en unos momentos.</p>

            @if (Model?.MostrarRequestId ?? false)
            {
                <p class="small text-muted">Código de solicitud: <code>@Model.RequestId</code></p>
            }

            <a class="btn btn-danger" asp-area="" asp-controller="Inicio" asp-action="Index">Volver al inicio</a>
        </div>
    </div>
</div>
