@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <h1 class="text-danger">Ocurrió un error</h1>
    <h2 class="text-danger">Se produjo un error al procesar su solicitud.</h2>

    @if (Model?.MostrarRequestId ?? false)
    {
        <p>
            <strong>Código de solicitud:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a class="btn btn-primary mt-3" asp-controller="Inicio" asp-action="Index">Volver al inicio</a>
</div>
