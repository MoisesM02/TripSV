@inject SignInManager<Usuario> gestorSesion
@inject UserManager<Usuario> gestorUsuarios
@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var areaActual = ViewContext.RouteData.Values["area"]?.ToString();

    string Activo(string controlador) =>
        string.IsNullOrEmpty(areaActual) && string.Equals(controladorActual, controlador, StringComparison.OrdinalIgnoreCase)
            ? "active"
            : string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Trips SV</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable saltar-contenido" href="#contenido">Saltar al contenido</a>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg navbar-dark navbar-principal">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand" asp-area="" asp-controller="Inicio" asp-action="Index">
                    <span class="marca-icono"><i class="bi bi-geo-alt-fill"></i></span>
                    Trips SV
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav me-auto ms-lg-3 gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @Activo("Inicio")" asp-area="" asp-controller="Inicio" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Categorias")" asp-area="" asp-controller="Categorias" asp-action="Index">Categorías</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @Activo("Sitios")" asp-area="" asp-controller="Sitios" asp-action="Index">Destinos</a>
                        </li>
                        @if (User.IsInRole(Roles.Administrador))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @(string.IsNullOrEmpty(areaActual) ? string.Empty : "active")" href="#"
                                   id="menuAdministrar" role="button" data-bs-toggle="dropdown" aria-expanded="false">Administrar</a>
                                <ul class="dropdown-menu" aria-labelledby="menuAdministrar">
                                    <li>
                                        <a class="dropdown-item" asp-area="Administracion" asp-controller="Sitios" asp-action="Agregar">
                                            <i class="bi bi-plus-circle"></i> Agregar sitios
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Administracion" asp-controller="Sitios" asp-action="Index">
                                            <i class="bi bi-pencil-square"></i> Modificar sitios
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Administracion" asp-controller="Categorias" asp-action="Index">
                                            <i class="bi bi-tags"></i> Categorías
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Administracion" asp-controller="Moderacion" asp-action="Index">
                                            <i class="bi bi-shield-check"></i> Moderación
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <form class="d-flex my-2 my-lg-0 me-lg-3 buscador-menu" role="search" method="get"
                          asp-area="" asp-controller="Sitios" asp-action="Index">
                        <input class="form-control form-control-sm me-2" type="search" name="texto" maxlength="100"
                               placeholder="Buscar destinos" aria-label="Buscar destinos" />
                        <button class="btn btn-sm btn-outline-light" type="submit" aria-label="Buscar">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>

                    <ul class="navbar-nav">
                        @if (gestorSesion.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-nowrap d-flex align-items-center gap-2" href="#" id="menuUsuario"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="avatar avatar-chico">@(User.Identity?.Name?.Length > 0 ? User.Identity.Name[..1] : "?")</span>
                                    @User.Identity?.Name
                                    @if (User.IsInRole(Roles.Administrador))
                                    {
                                        <span class="badge bg-warning text-dark">Admin</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="menuUsuario">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Favoritos" asp-action="Index">
                                            <i class="bi bi-heart"></i> Mis favoritos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-controller="Itinerarios" asp-action="Index">
                                            <i class="bi bi-calendar3"></i> Mis itinerarios
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-area="" asp-controller="Cuenta" asp-action="CerrarSesion" method="post">
                                            <button type="submit" class="dropdown-item">
                                                <i class="bi bi-box-arrow-right"></i> Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-nowrap" asp-area="" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a>
                            </li>
                            <li class="nav-item ms-lg-1">
                                <a class="btn btn-danger btn-sm mt-1" asp-area="" asp-controller="Cuenta" asp-action="Registrar">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" id="contenido" tabindex="-1">
        <partial name="_Mensajes" />
        @RenderBody()
    </main>

    <footer class="pie">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-5">
                    <h5 class="d-flex align-items-center gap-2">
                        <span class="marca-icono"><i class="bi bi-geo-alt-fill"></i></span>
                        Trips SV
                    </h5>
                    <p class="mt-3 mb-0">
                        Somos una empresa sin fines de lucro que busca ayudar a los turistas que quieren visitar
                        algunos lugares de El Salvador, brindando información sobre los sitios más interesantes y
                        bellos de este maravilloso país.
                    </p>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Explorar</h6>
                    <ul>
                        <li><a asp-area="" asp-controller="Inicio" asp-action="Index">Inicio</a></li>
                        <li><a asp-area="" asp-controller="Categorias" asp-action="Index">Categorías</a></li>
                        <li><a asp-area="" asp-controller="Sitios" asp-action="Index">Destinos</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Su cuenta</h6>
                    <ul>
                        @if (gestorSesion.IsSignedIn(User))
                        {
                            <li><a asp-area="" asp-controller="Favoritos" asp-action="Index">Mis favoritos</a></li>
                            <li><a asp-area="" asp-controller="Itinerarios" asp-action="Index">Mis itinerarios</a></li>
                        }
                        else
                        {
                            <li><a asp-area="" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión</a></li>
                            <li><a asp-area="" asp-controller="Cuenta" asp-action="Registrar">Registrarse</a></li>
                        }
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6>Contáctenos</h6>
                    <ul class="contacto">
                        <li><i class="bi bi-building"></i>Universidad Don Bosco</li>
                        <li><i class="bi bi-envelope"></i><a href="mailto:trips.sv2026@gmail.com">trips.sv2026@gmail.com</a></li>
                        <li><i class="bi bi-telephone"></i>1234-5678 o 9876-5432</li>
                    </ul>
                </div>
            </div>
            <div class="pie-inferior d-flex flex-column flex-md-row justify-content-between gap-2">
                <span>&copy; @DateTime.Now.Year Trips SV. Todos los derechos reservados.</span>
                <span>Hecho con cariño en El Salvador</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
