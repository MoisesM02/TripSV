@model List<Categoria>

<div class="container py-4">
    <div class="encabezado-pagina">
        <span class="antetitulo">Explore</span>
        <h1>Categorías turísticas</h1>
        <p>Elija el tipo de experiencia que busca y descubra los destinos de cada una.</p>
    </div>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Todavía no hay categorías publicadas.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var categoria in Model)
            {
                <div class="col-sm-6 col-lg-4">
                    <partial name="_TarjetaCategoria" model="categoria" />
                </div>
            }
        </div>
    }
</div>
