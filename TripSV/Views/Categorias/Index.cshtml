@model List<Categoria>

<div class="container py-4">
    <h1 class="mb-4">Categorías turísticas</h1>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">Todavía no hay categorías publicadas.</div>
    }
    else
    {
        <div class="row">
            @foreach (var categoria in Model)
            {
                <div class="col-md-4 cats-slides mb-4">
                    <div class="card mb-2 h-100">
                        <img class="card-img-top cats-slide" src="@Url.Action("Imagen", "Categorias", new { id = categoria.Id })"
                             alt="@categoria.Nombre" height="175" />
                        <div class="card-body d-flex flex-column">
                            <h4 class="card-title text-center primera-mayuscula">@categoria.Nombre</h4>
                            <p class="card-text line-clamp text-justify">@categoria.Descripcion</p>
                            <div class="mt-auto">
                                <span class="badge bg-secondary mb-2">@categoria.Sitios.Count sitio(s)</span>
                                <a class="btn btn-primary w-100 text-white"
                                   asp-controller="Sitios" asp-action="MostrarSitios" asp-route-id="@categoria.Id">Ver más</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
