@model ModeracionViewModel

<div class="container-fluid py-4">
    <h1 class="mb-3">Moderación de comentarios</h1>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Model.TotalVisibles</h5>
                    <p class="card-text text-muted mb-0">Visibles</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">@Model.TotalOcultos</h5>
                    <p class="card-text text-muted mb-0">Ocultos</p>
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-5">
            <input type="search" name="filtro" value="@Model.Filtro" class="form-control"
                   placeholder="Buscar por comentario, usuario o sitio" />
        </div>
        <div class="col-md-3 d-flex align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="soloOcultos" value="true"
                       id="soloOcultos" checked="@Model.SoloOcultos" />
                <label class="form-check-label" for="soloOcultos">Mostrar solo ocultos</label>
            </div>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-outline-primary w-100">Filtrar</button>
        </div>
        <div class="col-md-2">
            <a class="btn btn-outline-secondary w-100" asp-action="Index">Limpiar</a>
        </div>
    </form>

    @if (Model.Comentarios.Count == 0)
    {
        <div class="alert alert-info">No se encontraron comentarios con ese criterio.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Usuario</th>
                        <th>Sitio</th>
                        <th>Tipo</th>
                        <th>Comentario</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comentario in Model.Comentarios)
                    {
                        <tr class="@(comentario.Oculto ? "table-warning" : "")">
                            <td>@comentario.Id</td>
                            <td>@comentario.NombreUsuario</td>
                            <td>
                                <a asp-area="" asp-controller="Sitios" asp-action="Detalle" asp-route-id="@comentario.SitioId">
                                    @comentario.Sitio?.Nombre
                                </a>
                            </td>
                            <td>
                                @if (comentario.RespuestaAId is null)
                                {
                                    <span class="badge bg-primary">Reseña</span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">Respuesta a #@comentario.RespuestaAId</span>
                                }
                            </td>
                            <td style="max-width: 420px;">@comentario.Texto</td>
                            <td class="text-nowrap">@comentario.Fecha.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td>
                                @if (comentario.Oculto)
                                {
                                    <span class="badge bg-warning text-dark">Oculto</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Visible</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (comentario.Oculto)
                                {
                                    <form asp-action="Mostrar" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@comentario.Id" />
                                        <input type="hidden" name="filtro" value="@Model.Filtro" />
                                        <input type="hidden" name="soloOcultos" value="@Model.SoloOcultos.ToString().ToLowerInvariant()" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Mostrar</button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Ocultar" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@comentario.Id" />
                                        <input type="hidden" name="filtro" value="@Model.Filtro" />
                                        <input type="hidden" name="soloOcultos" value="@Model.SoloOcultos.ToString().ToLowerInvariant()" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Ocultar</button>
                                    </form>
                                }
                                <form asp-action="Eliminar" method="post" class="d-inline"
                                      onsubmit="return confirm('¿Seguro que desea eliminar este comentario y sus respuestas?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@comentario.Id" />
                                    <input type="hidden" name="filtro" value="@Model.Filtro" />
                                    <input type="hidden" name="soloOcultos" value="@Model.SoloOcultos.ToString().ToLowerInvariant()" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
