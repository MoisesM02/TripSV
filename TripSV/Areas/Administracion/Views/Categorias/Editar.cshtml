@model Categoria

<div class="container py-4">
    <h1 class="mb-4">Editar categoría</h1>

    <form asp-action="Editar" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" autofocus />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Imagen actual</label><br />
                    <img src="@Url.Action("Imagen", "Categorias", new { area = "", id = Model.Id })"
                         alt="@Model.Nombre" width="220" class="rounded mb-2" />
                </div>

                <div class="mb-3">
                    <label for="imagen" class="form-label">Reemplazar imagen</label>
                    <input type="file" name="imagen" id="imagen" class="form-control" accept=".jpg,.jpeg,.png" />
                    <div class="form-text">Déjelo vacío para conservar la imagen actual.</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="8" maxlength="200"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-danger">Actualizar</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
