@model List<Categoria>
@{
    var buscar = ViewBag.Buscar as string;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>Categorías</h1>
        <a class="btn btn-primary" asp-action="Crear">Nueva categoría</a>
    </div>

    <form asp-action="Index" method="get" class="row g-2 mb-4">
        <div class="col-md-6">
            <input type="search" name="buscar" value="@buscar" class="form-control" placeholder="Buscar categorías" />
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-primary w-100">Buscar</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(buscar))
        {
            <div class="col-md-3">
                <a class="btn btn-outline-secondary w-100" asp-action="Index">Limpiar</a>
            </div>
        }
    </form>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">No se encontraron categorías.</div>
    }
    else
    {
        <table class="table table-hover table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Imagen</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Sitios</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var categoria in Model)
                {
                    <tr>
                        <td>@categoria.Id</td>
                        <td>
                            <img src="@Url.Action("Imagen", "Categorias", new { area = "", id = categoria.Id })"
                                 alt="@categoria.Nombre" width="80" height="60" class="rounded object-fit-cover" />
                        </td>
                        <td class="primera-mayuscula">@categoria.Nombre</td>
                        <td class="line-clamp">@categoria.Descripcion</td>
                        <td>@categoria.Sitios.Count</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@categoria.Id">Editar</a>
                            <form asp-action="Eliminar" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Seguro que desea eliminar esta categoría?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@categoria.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
