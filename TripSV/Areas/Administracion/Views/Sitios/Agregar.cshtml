@model SitioFormularioViewModel

<div class="container py-4">
    <h1 class="mb-4">Agregar sitio turístico</h1>

    <form asp-action="Agregar" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-lg-6">
                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" autofocus />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoriaId" class="form-label"></label>
                    <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
                        <option value="">Seleccione una categoría</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Ubicacion" class="form-label"></label>
                    <input asp-for="Ubicacion" class="form-control" />
                    <span asp-validation-for="Ubicacion" class="text-danger"></span>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="5" maxlength="500"
                              placeholder="Escriba una breve descripción del sitio"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Imagen" class="form-label"></label>
                    <input asp-for="Imagen" type="file" class="form-control" accept=".jpg,.jpeg,.png" required />
                    <div class="form-text">Formatos .jpg, .jpeg o .png. Tamaño máximo 5 MB.</div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Informacion" class="form-label"></label>
            <textarea asp-for="Informacion" id="informacion" class="form-control" rows="10"
                      placeholder="Escriba toda la información del sitio"></textarea>
        </div>

        <button type="submit" class="btn btn-danger">Agregar sitio</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/ckeditor/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('informacion');
    </script>
}
