@model SitioFormularioViewModel

<div class="container py-4">
    <h1 class="mb-4">Modificar sitio turístico</h1>

    <form asp-action="Modificar" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="TieneImagen" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-lg-6">
                <div class="mb-3">
                    <label class="form-label">ID seleccionado</label>
                    <p class="fs-5">@Model.Id</p>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" autofocus />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoriaId" class="form-label"></label>
                    <select asp-for="CategoriaId" asp-items="Model.Categorias" class="form-select">
                        <option value="">Seleccione una categoría</option>
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Ubicacion" class="form-label"></label>
                    <input asp-for="Ubicacion" class="form-control" />
                    <span asp-validation-for="Ubicacion" class="text-danger"></span>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label"></label>
                    <textarea asp-for="Descripcion" class="form-control" rows="5" maxlength="500"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                @if (Model.TieneImagen)
                {
                    <div class="mb-3">
                        <label class="form-label">Imagen actual</label><br />
                        <img src="@Url.Action("Imagen", "Sitios", new { area = "", id = Model.Id })"
                             alt="@Model.Nombre" width="260" class="rounded" />
                    </div>
                }

                <div class="mb-3">
                    <label asp-for="Imagen" class="form-label">Reemplazar imagen</label>
                    <input asp-for="Imagen" type="file" class="form-control" accept=".jpg,.jpeg,.png" />
                    <div class="form-text">Déjelo vacío para conservar la imagen actual.</div>
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Informacion" class="form-label"></label>
            <textarea asp-for="Informacion" id="informacion" class="form-control" rows="10"></textarea>
        </div>

        <button type="submit" class="btn btn-danger">Actualizar información</button>
        <a class="btn btn-secondary" asp-action="Index">Cancelar</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/lib/ckeditor/ckeditor.js"></script>
    <script>
        CKEDITOR.replace('informacion');
    </script>
}
